{
  "hosting": {
    "source": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "1GiB",
      "cpu": 1,
      "minInstances": 0
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "emulators": {
    "dataconnect": {
      "port": 9400
    },
    "ui": {
      "enabled": true
    }
  }
}
